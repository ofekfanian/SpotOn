// APIKeys.xcconfig — NEVER commit this file with a real key.
// Add it to .gitignore: echo "SpotOn/Config/APIKeys.xcconfig" >> .gitignore
//
// HOW TO WIRE IT UP IN XCODE (one-time manual step):
//   1. Project navigator → select "SpotOn" project (blue icon)
//   2. Info tab → Configurations
//   3. For Debug AND Release, expand and set "SpotOn" target to "APIKeys"
//   4. Open Info.plist (SpotOn/Info.plist) and add:
//        Key:   GeminiAPIKey
//        Value: $(GEMINI_API_KEY)
//   5. Secrets.swift already reads Bundle.main.infoDictionary["GeminiAPIKey"]
//
// Share the real key with teammates via a password manager or
// a CI/CD secret (GEMINI_API_KEY env var).

GEMINI_API_KEY = PASTE_YOUR_KEY_HERE
